# Local development only — copy to .env and fill in values. Never commit .env.
#
# See docs/architecture.md → "Secrets and sensitive configuration" for the full list.

# Optional: TCG Marketplace live tests (api/gateway/tcgmarketplace)
# TCG_MARKETPLACE_ACCESS_TOKEN=

# Optional: Cards Central LGS search API key (api/gateway/cardscentral)
# CARDS_CENTRAL_KEY=

# Optional: local Vite proxy when testing against an origin-verify-enabled API
# VITE_API_ORIGIN_VERIFY_SECRET=

# Optional: Telegram bot → Gishath API bearer token (GET /telegram/search)
# API_TELEGRAM_BOT_TOKEN=

# Optional: GA4 Measurement Protocol for Telegram search events (search Lambda)
# GA4_MEASUREMENT_API_SECRET=
# GA4_MEASUREMENT_ID=G-6NRLSYZ9P9

# Optional: Telegram webhook service (Lambda mtg-telegram-bot or local api/cmd/telegram-bot)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PUBLIC_URL=https://your-api.example/telegram/webhook
# TELEGRAM_BOT_LAMBDA_FUNCTION=mtg-telegram-bot
# GISHATH_API_BASE_URL=https://api.gishathfetch.com
# API_ORIGIN_VERIFY_SECRET=
#
# Deploy (make deploy / GitHub Actions): set TELEGRAM_BOT_TOKEN to register slash
# commands via api/cmd/telegram-sync. Optional TELEGRAM_WEBHOOK_* re-registers webhook.

# Optional: Web Bot Auth directory generation (make generate-signature-directory)
# WEB_BOT_AUTH_PRIVATE_KEY_FILE=
