                },
                {
                  "key": "is_paginated",
                  "value": "true"
                },
                {
                  "key": "in_stock",
                  "value": "true"
                },
                {
                  "key": "sortVariation",
                  "value": "true"
                },
                {
                  "key": "category_id",
                  "value": "1"
                },
                {
                  "key": "variation_code",
                  "value": "all"
                },
                {
                  "key": "order_by",
                  "value": "Price Low to High"
                },
                {
                  "key": "search",
                  "value": "{{search_query}}"
                }
              ]
            },
            "description": "GET /api/products with MTG category filters and in_stock=true."
          }
        }
