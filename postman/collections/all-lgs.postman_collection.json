      "description": "REST product API at GET /api/products. No authentication required."
    },
    {
      "name": "The TCG Marketplace",
      "item": [
        {
          "name": "Advanced Search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
